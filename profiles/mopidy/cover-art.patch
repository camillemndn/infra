 import logging
 
 from mopidy import backend
-from mopidy.models import Ref, SearchResult
+from mopidy.models import Image, Ref, SearchResult
 from mopidy_subidy import uri
 
 logger = logging.getLogger(__name__)
@@ -41,6 +41,26 @@ class SubidyLibraryProvider(backend.LibraryProvider):
         super().__init__(*args, **kwargs)
         self.subsonic_api = self.backend.subsonic_api
 
+    def get_images(self, uris):
+        result = {}
+        for entry_uri in uris:
+            entry_type = uri.get_type(entry_uri)
+            if entry_type == uri.ALBUM:
+                item_id = uri.get_album_id(entry_uri)
+            elif entry_type == uri.ARTIST:
+                item_id = uri.get_artist_id(entry_uri)
+            elif entry_type == uri.SONG:
+                item_id = uri.get_song_id(entry_uri)
+            else:
+                item_id = None
+            if item_id is None:
+                result[entry_uri] = []
+            else:
+                result[entry_uri] = [
+                    Image(uri=self.subsonic_api.get_cover_art_uri(item_id))
+                ]
+        return result
+
     def browse_songs(self, album_id):
         return self.subsonic_api.get_songs_as_refs(album_id)
 
