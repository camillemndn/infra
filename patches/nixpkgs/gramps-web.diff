diff --git a/pkgs/development/python-modules/gramps/default.nix b/pkgs/development/python-modules/gramps/default.nix
new file mode 100644
index 000000000..5b083caa1
--- /dev/null
+++ b/pkgs/development/python-modules/gramps/default.nix
@@ -0,0 +1,154 @@
+{
+  stdenv,
+  lib,
+  buildPythonPackage,
+  fetchFromGitHub,
+  versionCheckHook,
+
+  # nativeBuildInputs
+  desktopToDarwinBundle,
+  gettext,
+  gobject-introspection,
+  intltool,
+  wrapGAppsHook3,
+
+  # buildInputs
+  gexiv2,
+  gtk3,
+  pango,
+
+  # build-system
+  setuptools,
+
+  # dependencies
+  berkeleydb,
+  orjson,
+  pycairo,
+  pygobject3,
+  pyicu,
+
+  # nativeCheckInputs
+  glibcLocales,
+  jsonschema,
+  lxml,
+  mock,
+  unittestCheckHook,
+  writableTmpDirAsHomeHook,
+
+  # Optional packages:
+  enableOSM ? true,
+  glib-networking,
+  osm-gps-map,
+  enableGraphviz ? true,
+  graphviz,
+  enableGhostscript ? true,
+  ghostscript,
+}:
+
+buildPythonPackage (finalAttrs: {
+  pname = "gramps";
+  version = "6.0.8";
+  pyproject = true;
+
+  src = fetchFromGitHub {
+    owner = "gramps-project";
+    repo = "gramps";
+    tag = "v${finalAttrs.version}";
+    hash = "sha256-Kq+QyhghBmUzl+ooCYSl2yNMvrBDnQS6Zg3nBI1jbRo=";
+  };
+
+  patches = [
+    # textdomain doesn't exist as a property on locale when running on Darwin
+    ./check-locale-hasattr-textdomain.patch
+    # disables the startup warning about bad GTK installation
+    ./disable-gtk-warning-dialog.patch
+  ];
+
+  nativeBuildInputs = [
+    gettext
+    gobject-introspection
+    intltool
+    wrapGAppsHook3
+  ]
+  # TODO: use JHBuild to build the Gramps' bundle
+  ++ lib.optionals stdenv.hostPlatform.isDarwin [
+    desktopToDarwinBundle
+  ];
+
+  buildInputs = [
+    gexiv2
+    gtk3
+    pango
+  ]
+  # Map support
+  ++ lib.optionals enableOSM [
+    glib-networking
+    osm-gps-map
+  ]
+  # Graphviz support
+  ++ lib.optional enableGraphviz graphviz
+  # Ghostscript support
+  ++ lib.optional enableGhostscript ghostscript;
+
+  build-system = [
+    setuptools
+  ];
+
+  dependencies = [
+    berkeleydb
+    orjson
+    pycairo
+    pygobject3
+    pyicu
+  ];
+
+  nativeCheckInputs = [
+    glibcLocales
+    jsonschema
+    lxml
+    mock
+    unittestCheckHook
+    writableTmpDirAsHomeHook
+  ];
+
+  dontWrapGApps = true;
+
+  preFixup = ''
+    makeWrapperArgs+=(
+      "''${gappsWrapperArgs[@]}"
+    )
+  '';
+
+  # https://github.com/NixOS/nixpkgs/issues/149812
+  # https://nixos.org/manual/nixpkgs/stable/#ssec-gnome-hooks-gobject-introspection
+  strictDeps = false;
+
+  pythonImportsCheck = [ "gramps" ];
+
+  nativeInstallCheckInputs = [
+    versionCheckHook
+    writableTmpDirAsHomeHook
+  ];
+  doInstallCheck = true;
+  versionCheckKeepEnvironment = [ "HOME" ];
+
+  meta = {
+    description = "Genealogy software";
+    mainProgram = "gramps";
+    homepage = "https://gramps-project.org";
+    maintainers = with lib.maintainers; [
+      jk
+      pinpox
+      tomasajt
+    ];
+    changelog = "https://github.com/gramps-project/gramps/blob/${finalAttrs.src.rev}/ChangeLog";
+    longDescription = ''
+      Every person has their own story but they are also part of a collective
+      family history. Gramps gives you the ability to record the many details of
+      an individual's life as well as the complex relationships between various
+      people, places and events. All of your research is kept organized,
+      searchable and as precise as you need it to be.
+    '';
+    license = lib.licenses.gpl2Plus;
+  };
+})
